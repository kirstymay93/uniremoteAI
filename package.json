{
  "name": "uniremoteai",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings=0",
    "test": "vitest",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fastify": "^4.24.0",
    "axios": "^1.4.0",
    "pino": "^8.14.0",
    "better-sqlite3": "^8.4.0",
    "dotenv": "^16.0.0",
    "openai": "^4.0.0",
    "node-ssdp": "^4.0.0",
    "mdns-js": "^0.5.7",
    "castv2-client": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "prettier": "^3.0.0",
    "vitest": "^1.3.0",
    "@types/node": "^20.0.0"
  }
}
